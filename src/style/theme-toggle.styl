// ボタン(label)の位置と大きさ。チェックボックスも同じ場所に重ねて置き、
// Tabでフォーカスしたときにページが別の位置(本来の配置先)へスクロールしないようにする
toggle-box()
	position: fixed
	top: 1.5rem
	right: 1.5rem
	width: 2.5rem
	height: 2.5rem

.theme-checkbox
	toggle-box()
	margin: 0
	opacity: 0
	pointer-events: none

.theme-toggle-label
	toggle-box()
	border-radius: 50%
	background: var(--surface)
	color: var(--text)
	cursor: pointer
	font-size: 1.25rem
	box-shadow: 0 2px 8px rgba(0, 0, 0, .15)
	transition: background .3s ease, color .3s ease, scale .2s ease, box-shadow .2s ease
	z-index: 100

	&:active
		scale: .94

	svg
		width: 1em
		height: 1em

	// 太陽は明るい表示、月は暗い表示のときだけ出るので、色は固定でよい(定義は @color.styl)
	.icon-moon
		display: none
		color: var(--moon)
	.icon-sun
		display: block
		color: var(--sun)

.theme-checkbox:focus-visible + .theme-toggle-label
	outline: 3px solid var(--red)
	outline-offset: 3px

@media (hover: hover)
	.theme-toggle-label:hover
		scale: 1.12
		box-shadow: 0 4px 14px rgba(0, 0, 0, .25)

// 実際に暗い表示のときは月を見せる
// (OSがダークでトグルOFF、またはOSがライトでトグルON)
show-moon()
	.theme-toggle-label
		.icon-moon
			display: block
		.icon-sun
			display: none

@media (prefers-color-scheme: dark)
	html:not(:has(#theme-toggle:checked))
		show-moon()

@media not all and (prefers-color-scheme: dark)
	html:has(#theme-toggle:checked)
		show-moon()
