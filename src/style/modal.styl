// popover属性によるモーダル(JS不要)。ESC/外側クリックで閉じ、フォーカスも標準で管理される

art-w = 1700  // CSSアート(image/header.svg)の描画サイズ
art-h = 1080

// ビューポートに収まる最大幅: 画面幅の92% と 画面高の92%×縦横比 の小さい方
// (min() はStylusの組み込み関数と衝突するので unquote で通す)
fit-width(unit)
	unquote('min(92vw, calc(92%s * %s / %s))' % (unit art-w art-h))

fade = opacity .2s ease

.avatar-modal
	// UA既定のpopoverスタイルを打ち消す
	border: 0
	padding: 0
	background: none
	color: #fff
	overflow: visible
	max-width: none
	max-height: none

	opacity: 0
	transition: fade, overlay .2s ease allow-discrete, display .2s ease allow-discrete

	&:popover-open
		opacity: 1

	&::backdrop
		background: rgba(0, 0, 0, .72)
		opacity: 0
		transition: fade

	&:popover-open::backdrop
		opacity: 1

	@starting-style
		&:popover-open, &:popover-open::backdrop
			opacity: 0

.avatar-modal-frame
	aspect-ratio: art-w / art-h
	width: fit-width(vh)
	width: fit-width(dvh)
	border-radius: .5rem
	box-shadow: 0 0 0 3px var(--red)
	overflow: hidden
	// 4MBあるCSSアートなので、モーダルを開くまで取得しないよう背景画像にする。
	// (<img loading="lazy"> は、Chromeだと非表示のpopover内でもすぐ取得されてしまう)
	background: #fff url("../image/header.svg") 0 0 / 100% 100% no-repeat

.avatar-modal-close
	position: fixed
	top: calc(1rem + env(safe-area-inset-top, 0px))
	right: calc(1.25rem + env(safe-area-inset-right, 0px))
	padding: 0
	border: 0
	background: none
	color: #fff
	font: inherit
	font-size: 2rem
	line-height: 1
	cursor: pointer

	&:focus-visible
		outline: 2px solid #fff
		outline-offset: 4px
		border-radius: .25rem

// モーダル表示中はテーマ切替を隠す(×ボタンと重なるため)
html:has(.avatar-modal:popover-open) .theme-toggle-label
	visibility: hidden
