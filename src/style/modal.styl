// <dialog> + Invoker Commands によるモーダル(JS不要)。
// 開いている間は背後のページが操作できなくなり(inert)、フォーカスもダイアログ内に閉じ込められる。
// Invoker Commands 未対応のブラウザでは popover として開くので、[open] と :popover-open の両方に書く。
// (セレクタを並べると、:popover-open を知らないブラウザでルールごと無視されるので、別々に書く)

art-w = 1700  // CSSアート(image/header.svg)の描画サイズ
art-h = 1080

fade = opacity .2s ease

.avatar-modal
	// UA既定のdialogスタイルを打ち消す
	border: 0
	padding: 0
	background: none
	color: #fff
	overflow: visible
	max-width: none
	max-height: none

	opacity: 0
	transition: fade, overlay .2s ease allow-discrete, display .2s ease allow-discrete

	&[open]
		opacity: 1
	&:popover-open
		opacity: 1

	&::backdrop
		background: rgb(0 0 0 / .72)
		opacity: 0
		transition: fade

	&[open]::backdrop
		opacity: 1
	&:popover-open::backdrop
		opacity: 1

	@starting-style
		&[open]
			opacity: 0
		&[open]::backdrop
			opacity: 0
		&:popover-open
			opacity: 0
		&:popover-open::backdrop
			opacity: 0

.avatar-modal-frame
	aspect-ratio: art-w / art-h
	// ビューポートに収まる最大幅: 画面幅の92% と 画面高の92%×縦横比 の小さい方
	width: min(92vw, 92vh * art-w / art-h)
	width: min(92vw, 92dvh * art-w / art-h)
	border-radius: .5rem
	box-shadow: 0 0 0 3px var(--red)
	overflow: hidden
	// 4MBあるCSSアートなので、モーダルを開くまで取得しないよう背景画像にする。
	// (<img loading="lazy"> は、Chromeだと閉じたダイアログ内でもすぐ取得されてしまう)
	background: #fff url("../image/header.svg") 0 0 / 100% 100% no-repeat

.avatar-modal-close
	position: fixed
	top: calc(1rem + env(safe-area-inset-top, 0px))
	right: calc(1.25rem + env(safe-area-inset-right, 0px))
	padding: 0
	border: 0
	background: none
	color: #fff
	font: inherit
	font-size: 2rem
	line-height: 1
	cursor: pointer

	&:focus-visible
		outline: 2px solid #fff
		outline-offset: 4px
		border-radius: .25rem

// モーダル表示中はテーマ切替を隠す(×ボタンと重なるため)
html:has(.avatar-modal[open]) .theme-toggle-label
	visibility: hidden
html:has(.avatar-modal:popover-open) .theme-toggle-label
	visibility: hidden
