.avatar-modal
	position: fixed
	inset: 0
	display: grid
	place-items: center
	background: rgba(0, 0, 0, .72)
	opacity: 0
	pointer-events: none
	transition: opacity .2s ease
	z-index: 200

	&:target
		opacity: 1
		pointer-events: auto

.avatar-modal-bg
	position: absolute
	inset: 0


.avatar-modal-frame
	position: relative
	container-type: inline-size
	aspect-ratio: 1700 / 1080
	width: unquote("min(92vw, calc(92vh * 1700 / 1080))")
	width: unquote("min(92vw, calc(92dvh * 1700 / 1080))")
	border-radius: .5rem
	box-shadow: 0 0 0 3px $red
	overflow: hidden
	background: #fff

.avatar-modal-img
	position: absolute
	top: 0
	left: 0
	transform-origin: 0 0
	scale: unquote("tan(atan2(100cqw, 1700px))")

.avatar-modal-close
	cursor: pointer
	position: absolute
	top: 1rem
	right: 1.25rem
	color: #fff
	font-size: 2rem
	text-decoration: none
	z-index: 10

html:has(.avatar-modal:target) .theme-toggle-label
	opacity: 0
	pointer-events: none
