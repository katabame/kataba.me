:root
	color-scheme: light dark
	--red: #ff0050
	--bg: light-dark(#fdf9f7, #0d0715)
	--text: light-dark(#1c0f2b, #e8dff0)
	--surface: light-dark(#fff, #1c0f2b)
	--circle: light-dark(rgb(255 0 106 / .2), rgb(255 0 106 / .3))
	// テーマ切替のアイコン。太陽は白い背景、月は暗い背景(--surface)の上に出る
	// (コントラスト比: 太陽 3.0:1、月 12.4:1)
	--sun: #e07b00
	--moon: #ffcf5c

// トグルをONにすると、OSの設定と反対のテーマになる
@media (prefers-color-scheme: dark)
	html:has(#theme-toggle:checked)
		color-scheme: light

@media not (prefers-color-scheme: dark)
	html:has(#theme-toggle:checked)
		color-scheme: dark
