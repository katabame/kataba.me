// 多層ソフトシャドウ。
//   --c: 色(r g b) / --y: 縦オフセットの倍率 / --a: 濃さの倍率
// 各層は「縦オフセット ぼかし 濃さ」。
soft-shadow()
	--c: 0 0 0
	--y: 1
	--a: 1
	box-shadow:
		0 calc(1.4px * var(--y)) 2.2px rgb(var(--c) / calc(.014 * var(--a))),
		0 calc(3.3px * var(--y)) 5.3px rgb(var(--c) / calc(.02 * var(--a))),
		0 calc(6.3px * var(--y)) 10px rgb(var(--c) / calc(.025 * var(--a))),
		0 calc(11.2px * var(--y)) 17.9px rgb(var(--c) / calc(.03 * var(--a))),
		0 calc(20.9px * var(--y)) 33.4px rgb(var(--c) / calc(.036 * var(--a))),
		0 calc(50px * var(--y)) 80px rgb(var(--c) / calc(.05 * var(--a)))

.button, .avatar
	soft-shadow()

.avatar
	--c: 255 0 80
	--y: 0
	--a: 2

@media (hover: hover)
	.button:hover
		--a: 2
