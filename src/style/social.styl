.button
	cursor: pointer
	border-radius: 15%
	background-color: var(--surface)
	color: var(--text)
	width: 5rem
	aspect-ratio: 1
	margin: 1rem
	transition: box-shadow .5s ease, background .3s ease, color .3s ease

	&:focus-visible
		outline: 3px solid var(--red)
		outline-offset: 4px

.icon
	font-size: 1.5rem
	text-decoration: none

	& svg
		width: 1em
		height: 1em
