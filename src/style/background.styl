body
	background: var(--bg)
	color: var(--text)
	font-family: 'Muli', system-ui, sans-serif
	transition: background .3s ease, color .3s ease

.circles
	z-index: -1
	position: fixed
	inset: 0
	overflow: hidden
	pointer-events: none

	& li
		position: absolute
		display: block
		list-style: none
		width: var(--size, 20px)
		aspect-ratio: 1
		left: var(--x)
		bottom: -150px
		background: var(--circle)
		animation: animate var(--dur, 25s) linear var(--delay, 0s) infinite

		&:nth-child(1)
			--x: 25%
			--size: 80px
			--delay: 0s

		&:nth-child(2)
			--x: 10%
			--size: 20px
			--delay: 2s
			--dur: 12s

		&:nth-child(3)
			--x: 70%
			--size: 20px
			--delay: 4s

		&:nth-child(4)
			--x: 40%
			--size: 60px
			--delay: 0s
			--dur: 18s

		&:nth-child(5)
			--x: 65%
			--size: 20px
			--delay: 0s

		&:nth-child(6)
			--x: 75%
			--size: 110px
			--delay: 3s

		&:nth-child(7)
			--x: 35%
			--size: 150px
			--delay: 7s

		&:nth-child(8)
			--x: 50%
			--size: 25px
			--delay: 15s
			--dur: 45s

		&:nth-child(9)
			--x: 20%
			--size: 15px
			--delay: 2s
			--dur: 35s

		&:nth-child(10)
			--x: 85%
			--size: 150px
			--delay: 0s
			--dur: 11s

@keyframes animate
	0%
		translate: 0 0
		rotate: 0deg
		opacity: 1
		border-radius: 0

	100%
		translate: 0 -110dvh
		rotate: 720deg
		opacity: 0
		border-radius: 50%
