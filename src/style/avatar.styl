.avatar
	border-radius: 50%
	// CSSアート(image/avatar-art.svg)はpx単位で描かれているので、remにすると文字サイズの設定次第でずれる
	width: 400px
	height: 400px
	background: #e3d4e9 url("../image/avatar-art.svg") 0 0 / 100% 100% no-repeat
	// zoomはレイアウト上の大きさも縮むので、負マージンやリンク側の寸法指定が要らない
	zoom: .5
	transition: rotate .3s ease

@media (hover: hover)
	.avatar:hover
		rotate: -15deg

.avatar-ring
	position: relative
	display: grid
	place-items: center

	&::before
		content: ""
		position: absolute
		// アバター(400px × zoom .5 = 200px)より一回り大きく
		width: 224px
		height: 224px
		border-radius: 50%
		// `in oklch` はStylusの演算子と衝突するので unquote で通す
		background: unquote("conic-gradient(from var(--angle) in oklch, var(--red), #b9a8e6, transparent 42%, var(--red))")
		mask: radial-gradient(farthest-side, transparent calc(100% - 6px), #000 calc(100% - 5px))
		animation: spin-angle 7s linear infinite
		pointer-events: none

.avatar-button
	display: block
	padding: 0
	border: 0
	background: none
	font: inherit
	color: inherit
	border-radius: 50%
	cursor: pointer
	// 位置指定された ::before(リング)より前面に出す
	position: relative

	&:focus-visible
		outline: 3px solid var(--red)
		outline-offset: 1rem

@property --angle
	syntax: "<angle>"
	initial-value: 0deg
	inherits: false

@keyframes spin-angle
	to
		--angle: 360deg
